#!/bin/bash

set -euo pipefail

# Only COMMITTED content reaches a user: `omarchy plugin add` clones this
# repository into the plugins directory, and the validator rejects the whole
# plugin if it finds a symlink there. Local symlinks that are never committed
# cannot reach anyone, which is why the runtime skill trees under
# .claude/skills/ and .codex/skills/ are gitignored rather than banned.
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "check symlinks: FAIL — not inside a git work tree, so tracked content cannot be read" >&2
  exit 1
fi
links=$(git ls-files -s | awk -F'\t' '$1 ~ /^120000/ { print $2 }')
if [[ -n $links ]]; then
  links=${links//$'\n'/, }
  echo "check symlinks: FAIL — a committed symlink makes the Omarchy plugin validator reject the whole plugin: $links" >&2
  echo "  Skill symlinks belong in the gitignored .claude/skills/ and .codex/skills/ trees; run bin/link-skills." >&2
  exit 1
fi
echo "check symlinks: PASS"

if ! command -v python3 >/dev/null 2>&1; then
  echo "check imports: FAIL — python3 is required" >&2
  exit 1
fi

if import_failures=$(python3 - <<'PY'
import ast
import subprocess
import sys
from pathlib import Path

# Scan every TRACKED file, not a fixed list of paths. Tracked content is exactly
# what ships: `omarchy plugin add` clones this repository onto the user's
# machine. A fixed list is what let tools/ sit here importing bleak until it was
# untracked in a264590 -- the files were outside the scanned paths, so the gate
# had nothing to say about them.
tracked = subprocess.run(
    ["git", "ls-files", "-z"], capture_output=True, check=True,
).stdout
paths = sorted(Path(name.decode()) for name in tracked.split(b"\0") if name)

RUNTIME = set(sys.stdlib_module_names) | {"gi", "walkingpad"}
# pytest is a dev-only dependency (python-pytest) and never enters the bridge's
# import path, so tests may use it and nothing else may. "tests" is this
# repository's own package, not a dependency: one test file importing a fixture
# or fake transport from a sibling installs nothing and cannot reach a user.
TESTS = RUNTIME | {"pytest", "tests"}


def is_python(path):
    # bin/walkingpad-bridge is the entry point and has no extension, so the
    # shebang is the only thing that identifies it.
    if path.suffix == ".py":
        return True
    try:
        with path.open("rb") as handle:
            first_line = handle.readline(256)
    except OSError:
        return False
    return first_line.startswith(b"#!") and b"python" in first_line


failures = []

for path in paths:
    if not is_python(path):
        continue
    allowed = TESTS if path.parts[0] == "tests" else RUNTIME
    try:
        tree = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
    except (OSError, SyntaxError) as error:
        failures.append(f"{path}: cannot parse imports ({error})")
        continue

    for node in ast.walk(tree):
        modules = []
        if isinstance(node, ast.Import):
            modules = [alias.name for alias in node.names]
        elif isinstance(node, ast.ImportFrom):
            if node.level:
                continue
            modules = [node.module or ""]

        for module in modules:
            top_level = module.split(".", 1)[0]
            if top_level and top_level not in allowed:
                failures.append(f"{path}: module '{module}'")

if failures:
    print("; ".join(failures))
    raise SystemExit(1)
PY
); then
  echo "check imports: PASS"
else
  echo "check imports: FAIL — a plugin cannot install a dependency and every tracked file ships; offending imports: $import_failures" >&2
  exit 1
fi

if [[ ! -f bin/walkingpad-bridge ]]; then
  echo "check entry point: FAIL — bin/walkingpad-bridge is missing" >&2
  exit 1
fi
if [[ ! -x bin/walkingpad-bridge ]]; then
  echo "check entry point: FAIL — bin/walkingpad-bridge is not executable" >&2
  exit 1
fi
first_line=""
IFS= read -r first_line < bin/walkingpad-bridge || true
if [[ $first_line != '#!/usr/bin/python3' ]]; then
  echo "check entry point: FAIL — bin/walkingpad-bridge must start with exactly #!/usr/bin/python3" >&2
  exit 1
fi
echo "check entry point: PASS"

manifest_fail() {
  echo "check manifest: FAIL — $*" >&2
  exit 1
}

if [[ ! -f manifest.json ]]; then
  echo "check manifest: SKIP — manifest.json is not present"
else
  command -v jq >/dev/null 2>&1 || manifest_fail "jq is required when manifest.json exists"
  jq -e . manifest.json >/dev/null 2>&1 || manifest_fail "manifest.json is not valid JSON"
  jq -e '.schemaVersion == 1' manifest.json >/dev/null 2>&1 \
    || manifest_fail "schemaVersion must be the JSON number 1"

  for field in id name version kinds entryPoints; do
    jq -e --arg field "$field" 'has($field)' manifest.json >/dev/null 2>&1 \
      || manifest_fail "required field '$field' is missing"
  done

  plugin_id=$(jq -r '.id // ""' manifest.json)
  [[ -n $plugin_id ]] || manifest_fail "id is empty"
  [[ $plugin_id =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] \
    || manifest_fail "id '$plugin_id' is invalid"
  [[ $plugin_id != *".."* ]] || manifest_fail "id '$plugin_id' contains '..'"
  [[ $plugin_id != omarchy.* ]] || manifest_fail "id '$plugin_id' uses the reserved omarchy.* namespace"

  jq -e '(.kinds | type) == "array" and (.kinds | length) > 0' manifest.json >/dev/null 2>&1 \
    || manifest_fail "kinds must be a non-empty array"
  jq -e '(.entryPoints | type) == "object"' manifest.json >/dev/null 2>&1 \
    || manifest_fail "entryPoints must be an object"

  jq -e '
    if ((.barWidget? | type) == "object" and (.barWidget | has("defaultSection"))) then
      .barWidget.defaultSection as $section
      | ($section | type) == "string"
        and (["left", "center", "right"] | index($section)) != null
    else
      true
    end
  ' manifest.json >/dev/null 2>&1 \
    || manifest_fail "barWidget.defaultSection must be left, center or right"

  while IFS= read -r entry_json; do
    [[ -n $entry_json ]] || continue
    entry_point=$(jq -r '.' <<<"$entry_json")
    [[ -n $entry_point ]] || manifest_fail "an entry-point path is empty"
    [[ $entry_point != *$'\n'* ]] || manifest_fail "entry point '$entry_point' contains a newline"
    [[ $entry_point != /* ]] || manifest_fail "entry point '$entry_point' is not relative"
    [[ $entry_point != *".."* ]] || manifest_fail "entry point '$entry_point' contains '..'"
    [[ -f "./$entry_point" ]] || manifest_fail "entry-point file '$entry_point' does not exist"
  done < <(jq -c '.entryPoints | to_entries[] | .value' manifest.json)

  for kind_entry_point in \
    "bar:bar" \
    "bar-widget:barWidget" \
    "menu:menu" \
    "overlay:overlay" \
    "panel:panel" \
    "service:service"; do
    kind=${kind_entry_point%%:*}
    entry_point=${kind_entry_point##*:}
    jq -e --arg kind "$kind" '(.kinds | index($kind)) != null' manifest.json >/dev/null 2>&1 \
      || continue
    jq -e --arg entry_point "$entry_point" '.entryPoints | has($entry_point)' manifest.json >/dev/null 2>&1 \
      || manifest_fail "kind '$kind' requires entryPoints.$entry_point"
  done

  echo "check manifest: PASS"
fi

plugin_fail() {
  echo "check plugin: FAIL — $*" >&2
  exit 1
}

if [[ ! -f manifest.json ]]; then
  echo "check plugin: SKIP — manifest.json is not present"
elif ! command -v omarchy-plugin-validate >/dev/null 2>&1; then
  # CI runs this script on ubuntu-latest, where the Omarchy validator does not
  # exist at all. Skipping on absence keeps the gate meaningful where it can run
  # without turning every CI run red where it cannot.
  echo "check plugin: SKIP — omarchy-plugin-validate is not present"
else
  # The validator scans a DIRECTORY, but what reaches a user is TRACKED CONTENT:
  # `omarchy plugin add` clones this repository. Validating the working tree
  # directly always fails, because .claude/skills/ and .codex/skills/ are the
  # gitignored symlink trees bin/link-skills creates locally (see AGENTS.md), and
  # the validator rejects a whole plugin on any symlink it finds. So export what
  # actually ships -- everything git tracks or has staged, plus files present but
  # not yet committed -- and validate that instead.
  plugin_export_dir=$(mktemp -d)
  trap 'rm -rf "$plugin_export_dir"' EXIT

  if ! { git ls-files -z; git ls-files -z --others --exclude-standard; } \
      | xargs -0 cp --parents --target-directory="$plugin_export_dir" --; then
    plugin_fail "could not export the shipped file list"
  fi

  if plugin_output=$(omarchy-plugin-validate "$plugin_export_dir" 2>&1); then
    echo "check plugin: PASS"
  else
    [[ -n $plugin_output ]] && echo "$plugin_output" >&2
    plugin_fail "omarchy-plugin-validate rejected the exported plugin tree"
  fi
fi

# ⚠ Two traps, both of which cost a review once. First, /usr/bin/qmllint on Arch
# is the QT5 binary (qt5-declarative); it reads Qt 6 QML, exits 255 with NO
# output at all, and every file "passes" without being checked. Only
# /usr/lib/qt6/bin/qmllint is the real one. Second, `-I $OMARCHY_PATH/shell`
# does NOT resolve `qs.Commons` / `qs.Ui`: quickshell maps the config root to
# `qs`, so qmllint needs an import path containing a `qs` directory. Without
# that mapping every qs.Ui type is "not found" and the type checking is hollow.
qml_files=$(git ls-files '*.qml'; git ls-files -o --exclude-standard '*.qml')
qml_files=$(printf '%s\n' "$qml_files" | sort -u | sed '/^$/d')

qmllint_bin=""
for candidate in /usr/lib/qt6/bin/qmllint "${QT6_QMLLINT:-}"; do
  [[ -n $candidate && -x $candidate ]] || continue
  if "$candidate" --version 2>&1 | grep -q "qmllint 6"; then
    qmllint_bin=$candidate
    break
  fi
done

if [[ -z $qml_files ]]; then
  echo "check qml: SKIP — no QML files are tracked"
elif [[ -z $qmllint_bin ]]; then
  # CI runs on ubuntu-latest, where Qt 6 is absent entirely. Skipping on absence
  # keeps the gate meaningful where it can run without turning CI red where it
  # cannot -- the same rule the plugin validator above follows.
  echo "check qml: SKIP — no Qt 6 qmllint (looked for /usr/lib/qt6/bin/qmllint)"
elif [[ ! -d ${OMARCHY_PATH:-}/shell ]]; then
  echo "check qml: SKIP — \$OMARCHY_PATH/shell is not present, so qs.* cannot resolve"
else
  qml_import_dir=$(mktemp -d)
  trap 'rm -rf "$plugin_export_dir" "$qml_import_dir"' EXIT
  ln -s "$OMARCHY_PATH/shell" "$qml_import_dir/qs"

  # Every file must be free of ERRORS. On top of that, a file listed here must
  # be free of warnings too, and stay that way. The panel and the analysis
  # window are deliberately absent: they carry long-standing unqualified-access
  # and missing-property warnings that predate this gate, and clearing those is
  # its own change. Add a file here once it is clean; never remove one.
  #
  # `-W 0` is deliberately not applied by count elsewhere: qmllint tallies
  # sub-warnings that its "Warning:" summary lines do not show, so a
  # hand-maintained numeric budget drifts out of agreement with what a reader
  # counts and fails for reasons nobody can reproduce by eye.
  qml_must_be_clean() {
    case ${1##*/} in
      WalkingpadBarChart.qml|WalkingpadTimeChart.qml) return 0 ;;
      *) return 1 ;;
    esac
  }

  qml_failed=0
  while IFS= read -r qml_file; do
    [[ -n $qml_file ]] || continue
    qml_args=(-I "$qml_import_dir")
    qml_must_be_clean "$qml_file" && qml_args+=(-W 0)
    if ! qml_output=$("$qmllint_bin" "${qml_args[@]}" "$qml_file" 2>&1); then
      echo "check qml: FAIL — $qml_file" >&2
      echo "$qml_output" | grep -E "^(Warning|Error):" | head -20 >&2
      qml_failed=1
    fi
  done <<<"$qml_files"

  if (( qml_failed )); then
    exit 1
  fi
  echo "check qml: PASS"
fi

if python3 -m pytest tests/ -q; then
  echo "check tests: PASS"
else
  echo "check tests: FAIL — python3 -m pytest tests/ -q failed" >&2
  exit 1
fi
