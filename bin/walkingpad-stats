#!/usr/bin/python3
"""Read the WalkingPad history store and emit one JSON query result."""
import os
import sys

# ⚠ Load-bearing, and it must run before any possible plugin-local import.
#
# This repository is the installed plugin, and the shell watches its directory
# recursively with inotifywait. A stray __pycache__ write therefore looks like
# a plugin edit and triggers a full reload that kills the live bridge. Keep the
# guard here even though this reader currently needs no walkingpad module, so a
# later import cannot turn opening the analysis window into a plugin reload.
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))

import argparse
import json
import math
from datetime import datetime, timedelta, timezone


def emit(payload):
    # Stage 3 §3.2 promises exactly one JSON object, which excludes Python's
    # permissive NaN and Infinity tokens because the QML caller uses JSON.parse.
    print(json.dumps(payload, allow_nan=False))


class JsonArgumentParser(argparse.ArgumentParser):
    def error(self, message):
        emit({"error": message})
        sys.exit(1)


def default_store_dir():
    state_home = os.environ.get("XDG_STATE_HOME")
    if not state_home:
        state_home = os.path.join(os.path.expanduser("~"), ".local", "state")
    return os.path.join(state_home, "walkingpad")


# Charts §2.4's ladder, and the cap that selects a rung from it. Deterministic on
# purpose: a "pretty" rung chosen from the data would move the axis under someone
# comparing two days. Every rung is a whole multiple of the one below it, which is
# what makes coarsening a 60 s pass into any of them exact rather than approximate.
BUCKET_LADDER_S = (60, 300, 900, 3600, 21600, 86400, 604800)
MAX_PROFILE_BUCKETS = 120
PROFILE_BASE_BUCKET_S = 60

# Buckets are aligned to the Unix epoch: floor(t / bucket_s) * bucket_s. Civil
# offsets are whole minutes, so every rung up to an hour lands on a local
# wall-clock minute or hour; the day and week rungs are consequently UTC-aligned,
# and only spans long enough to need them are affected. WalkingpadModel.js repeats
# this convention for the popup's 60 one-minute buckets (charts §6) and the two
# copies must keep agreeing at a boundary.

# The bridge polls once a second while the belt moves and every two seconds while
# it is idle (bridge.py POLL_INTERVAL_S / IDLE_POLL_INTERVAL_S), and
# Safety.stale_after_s is 3.0 s. A wider separation between adjacent samples is a
# hole in the record rather than an interval anything observed. Mirrored here
# instead of imported, exactly as store.py mirrors the same cadence: this reader
# must stay startable without the bridge's own modules.
MAX_SAMPLE_INTERVAL_S = 3.0

SECONDS_PER_DAY = 86400.0


def finite_nonnegative_float(value):
    try:
        number = float(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError(str(exc)) from exc
    # Stage 3 §3.2 exposes gap_minutes as presentation policy, but it still has
    # to describe a real interval. Reject non-finite and negative values at the
    # argument boundary so neither grouping nor JSON output can carry them.
    if not math.isfinite(number) or number < 0:
        raise argparse.ArgumentTypeError("must be finite and greater than or equal to 0")
    return number


def bucket_argument(value):
    if value == "auto":
        # None means "apply charts §2.4's ladder here", and bucket_s in the
        # result reports what that chose.
        return None
    try:
        seconds = int(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError(
            "must be 'auto' or a whole number of seconds") from exc
    if seconds <= 0:
        raise argparse.ArgumentTypeError(
            "must be 'auto' or a whole number of seconds greater than 0")
    return seconds


def build_parser():
    parser = JsonArgumentParser(
        description="Read WalkingPad history (stdout JSON)", add_help=False)
    commands = parser.add_subparsers(dest="command", required=True)

    sessions = commands.add_parser("sessions", add_help=False)
    sessions.add_argument("--since")
    sessions.add_argument("--until")
    sessions.add_argument("--gap", type=finite_nonnegative_float, default=5.0)
    sessions.add_argument("--store", default=default_store_dir())

    session = commands.add_parser("session", add_help=False)
    session.add_argument("--start", type=float, required=True)
    session.add_argument("--gap", type=finite_nonnegative_float, default=5.0)
    session.add_argument("--store", default=default_store_dir())

    totals = commands.add_parser("totals", add_help=False)
    totals.add_argument("--by", choices=("day", "week", "month", "all"),
                        required=True)
    totals.add_argument("--since")
    totals.add_argument("--until")
    totals.add_argument("--store", default=default_store_dir())

    profile = commands.add_parser("profile", add_help=False)
    profile.add_argument("--since")
    profile.add_argument("--until")
    profile.add_argument("--bucket", type=bucket_argument, default=None)
    # Accepted so the analysis window can forward one uniform set of arguments to
    # every history query. It deliberately changes nothing here: a profile
    # aggregates bouts and samples, and neither totals nor buckets depend on
    # where §1.3's session boundaries fall. Rejecting it instead is the mistake
    # `totals` already caused once -- argparse answered with an error object
    # where the window expected data.
    profile.add_argument("--gap", type=finite_nonnegative_float, default=5.0)
    profile.add_argument("--store", default=default_store_dir())

    residuals = commands.add_parser("residuals", add_help=False)
    residuals.add_argument("--store", default=default_store_dir())
    return parser


def is_number(value):
    return type(value) in (int, float)


def require_type(value, expected, field):
    if type(value) is not expected:
        raise ValueError(f"{field} has the wrong type")


def require_number(value, field):
    if not is_number(value):
        raise ValueError(f"{field} has the wrong type")


def validate_bout(bout):
    if not isinstance(bout, dict):
        raise ValueError("bouts.jsonl row is not an object")
    require_type(bout["e"], int, "bout.e")
    require_number(bout["start"], "bout.start")
    require_number(bout["end"], "bout.end")
    require_type(bout["observed"], bool, "bout.observed")
    require_type(bout["dur_s"], int, "bout.dur_s")
    require_number(bout["dist_km"], "bout.dist_km")
    require_type(bout["steps"], int, "bout.steps")
    if bout["observed"]:
        require_number(bout["v_avg"], "bout.v_avg")
        require_number(bout["v_max"], "bout.v_max")
        require_type(bout["n"], int, "bout.n")


def validate_sample(sample):
    if not isinstance(sample, dict):
        raise ValueError("sample row is not an object")
    require_number(sample["t"], "sample.t")
    require_type(sample["e"], int, "sample.e")
    require_type(sample["b"], str, "sample.b")
    require_type(sample["m"], str, "sample.m")
    require_number(sample["v"], "sample.v")
    for field in ("c", "g"):
        if sample[field] is not None:
            require_number(sample[field], f"sample.{field}")
    require_number(sample["d"], "sample.d")
    require_type(sample["s"], int, "sample.s")
    require_type(sample["pe"], int, "sample.pe")


def iter_jsonl(path, validator, skipped_rows):
    """Yield validated rows one at a time, counting unreadable ones.

    Streaming is what lets `profile` cross a whole period of sample files without
    holding them: a year of walking is over a million rows, and charts §4 puts
    that work here precisely so neither the bridge nor the UI thread carries it.
    `skipped_rows` is a one-element list because a generator's return value is
    not reachable from an ordinary `for`.
    """
    try:
        stream = open(path, "r", encoding="utf-8")
    except FileNotFoundError:
        return

    with stream:
        for line in stream:
            try:
                row = json.loads(line)
                validator(row)
            except Exception:
                # Stage 3 §2.2/§2.3 never prune these durable files. A torn,
                # future-schema, hand-edited or wrong-shaped row must therefore
                # cost only itself, not every later query; count it so "empty"
                # remains distinguishable from "all rows unreadable".
                skipped_rows[0] += 1
                continue
            yield row


def read_jsonl(path, validator):
    skipped_rows = [0]
    rows = list(iter_jsonl(path, validator, skipped_rows))
    return rows, skipped_rows[0]


def read_bouts(store_dir):
    return read_jsonl(os.path.join(store_dir, "bouts.jsonl"), validate_bout)


def parse_iso(value):
    if value is None:
        return None
    return datetime.fromisoformat(value).timestamp()


def filter_bouts(bouts, since, until):
    since_ts = parse_iso(since)
    until_ts = parse_iso(until)
    # Stage 3 §3.2 makes these literal local timestamps. In particular, a
    # date-only --until is midnight, not an invitation to widen it to end-of-day.
    return [
        bout for bout in bouts
        if (since_ts is None or bout["start"] >= since_ts)
        and (until_ts is None or bout["start"] <= until_ts)
    ]


def group_sessions(bouts, gap_minutes):
    ordered = sorted(bouts, key=lambda bout: bout["start"])
    groups = []
    group_end = None
    for bout in ordered:
        if not groups:
            groups.append([bout])
            group_end = bout["end"]
            continue
        # Stage 3 §1.3 groups by the gap from the session's covered span, not
        # merely from the row most recently sorted by start. Nested or overlapping
        # bouts may end earlier than an older long bout, so carry the maximum end;
        # strictly less than the configured gap merges and equality still splits.
        if bout["start"] - group_end < gap_minutes * 60:
            groups[-1].append(bout)
            group_end = max(group_end, bout["end"])
        else:
            groups.append([bout])
            group_end = bout["end"]
    return groups


# Stage 3 §1.3/§2.3 makes an unobserved bout's counter totals exact even
# though its placement and speed curve are unknown. Include that share in the
# true total, disclose it separately, and never invent sample-derived speeds for
# it. Treating unobserved_* as an alternative total would under-report the pad.
def summarize_bouts(bouts):
    observed_bouts = [bout for bout in bouts if bout["observed"]]
    unobserved_bouts = [bout for bout in bouts if not bout["observed"]]
    sample_count = sum(bout["n"] for bout in observed_bouts)

    v_avg = None
    if observed_bouts and sample_count:
        weighted_speed = sum(
            bout["v_avg"] * bout["n"] for bout in observed_bouts)
        v_avg = round(weighted_speed / sample_count, 1)
    v_max = None
    if observed_bouts:
        v_max = round(max(bout["v_max"] for bout in observed_bouts), 1)

    return {
        "start": bouts[0]["start"],
        "end": max(bout["end"] for bout in bouts),
        "dur_s": sum(bout["dur_s"] for bout in bouts),
        "dist_km": round(sum(
            (bout["dist_km"] for bout in bouts), 0.0), 2),
        "steps": sum(bout["steps"] for bout in bouts),
        "v_avg": v_avg,
        "v_max": v_max,
        "observed": all(bout["observed"] for bout in bouts),
        "unobserved_s": sum(bout["dur_s"] for bout in unobserved_bouts),
        "unobserved_dist_km": round(sum(
            (bout["dist_km"] for bout in unobserved_bouts), 0.0), 2),
        "unobserved_steps": sum(
            bout["steps"] for bout in unobserved_bouts),
        "bouts": bouts,
    }


def query_sessions(args):
    bouts, skipped_rows = read_bouts(args.store)
    bouts = filter_bouts(bouts, args.since, args.until)
    groups = group_sessions(bouts, args.gap)
    return {
        "gap_minutes": args.gap,
        "sessions": [summarize_bouts(group) for group in groups],
        "skipped_rows": skipped_rows,
    }


MAX_SESSION_SAMPLE_DAYS = 31


def utc_dates(start, end):
    current = datetime.fromtimestamp(start, tz=timezone.utc).date()
    final = datetime.fromtimestamp(end, tz=timezone.utc).date()
    while current <= final:
        yield current.isoformat()
        current += timedelta(days=1)


def read_session_samples(store_dir, start, end):
    samples = []
    skipped_rows = 0
    # Stage 3 §3.2 keeps unbounded sample work away from both the bridge and
    # the UI. A detail query therefore opens only UTC-day files touched by this
    # resolved session, never every file under samples/. Thirty-one days is far
    # beyond a real session's minutes-to-hours span, but caps an adversarial bout
    # before an implausible range turns into millions of failed file opens.
    first_date = datetime.fromtimestamp(start, tz=timezone.utc).date()
    last_date = datetime.fromtimestamp(end, tz=timezone.utc).date()
    day_count = (last_date - first_date).days + 1
    if day_count > MAX_SESSION_SAMPLE_DAYS:
        raise ValueError(
            f"session spans {day_count} UTC sample days; maximum is "
            f"{MAX_SESSION_SAMPLE_DAYS}"
        )
    for date_string in utc_dates(start, end):
        path = os.path.join(store_dir, "samples", f"{date_string}.jsonl")
        file_samples, file_skipped_rows = read_jsonl(path, validate_sample)
        skipped_rows += file_skipped_rows
        for sample in file_samples:
            if start <= sample["t"] <= end:
                samples.append(sample)
    return sorted(samples, key=lambda sample: sample["t"]), skipped_rows


def query_session(args):
    bouts, skipped_bouts = read_bouts(args.store)
    groups = group_sessions(bouts, args.gap)
    match = next(
        (group for group in groups if group[0]["start"] == args.start), None)
    if match is None:
        raise ValueError(f"session starting at {args.start} was not found")
    summary = summarize_bouts(match)
    samples, skipped_samples = read_session_samples(
        args.store, summary["start"], summary["end"])
    return {
        "gap_minutes": args.gap,
        "session": summary,
        "samples": samples,
        "skipped_rows": skipped_bouts + skipped_samples,
    }


def bucket_key(bout, by):
    if by == "all":
        return "all"
    local_date = datetime.fromtimestamp(bout["start"]).date()
    if by == "day":
        return local_date.isoformat()
    if by == "week":
        return (local_date - timedelta(days=local_date.weekday())).isoformat()
    return local_date.strftime("%Y-%m")


def query_totals(args):
    bouts, skipped_rows = read_bouts(args.store)
    bouts = filter_bouts(bouts, args.since, args.until)
    grouped = {}
    for bout in bouts:
        grouped.setdefault(bucket_key(bout, args.by), []).append(bout)

    buckets = []
    for key in sorted(grouped):
        bouts_in_bucket = sorted(grouped[key], key=lambda bout: bout["start"])
        summary = summarize_bouts(bouts_in_bucket)
        buckets.append({
            "key": key,
            "start": min(bout["start"] for bout in bouts_in_bucket),
            "end": max(bout["end"] for bout in bouts_in_bucket),
            "dur_s": summary["dur_s"],
            "dist_km": summary["dist_km"],
            "steps": summary["steps"],
            "v_avg": summary["v_avg"],
            "unobserved_s": summary["unobserved_s"],
            "unobserved_dist_km": summary["unobserved_dist_km"],
            "unobserved_steps": summary["unobserved_steps"],
        })
    return {"by": args.by, "buckets": buckets,
            "skipped_rows": skipped_rows}


def finite(value):
    # validate_sample only proves a field is a number, and json.loads accepts the
    # Infinity and NaN tokens. Every value that reaches an aggregate is checked
    # here so emit()'s allow_nan=False can never turn one hand-edited row into a
    # failed query for the whole period.
    return type(value) in (int, float) and math.isfinite(value)


def bucket_start(timestamp, bucket_s):
    return math.floor(timestamp / bucket_s) * bucket_s


def new_profile_bucket():
    return {"steps": 0, "dist_km": 0.0, "dur_s": 0, "v_sum": 0.0, "v_n": 0}


def sample_files_in_range(store_dir, since, until):
    directory = os.path.join(store_dir, "samples")
    try:
        names = os.listdir(directory)
    except OSError:
        # An absent or unreadable samples directory is the ordinary empty-store
        # result, exactly like a missing bouts.jsonl.
        return []

    files = []
    for name in names:
        if not name.endswith(".jsonl"):
            continue
        try:
            # store.py names each file for the UTC date of the frames inside it.
            day = datetime.strptime(name[:-len(".jsonl")], "%Y-%m-%d")
        except ValueError:
            continue
        day_start = day.replace(tzinfo=timezone.utc).timestamp()
        day_end = day_start + SECONDS_PER_DAY
        if since is not None and day_end <= since:
            continue
        if until is not None and day_start > until:
            continue
        files.append((day_start, os.path.join(directory, name)))
    files.sort()
    return [path for _, path in files]


def accumulate_interval(previous, sample, bucket, histogram):
    if previous is None:
        return
    if previous["e"] != sample["e"]:
        # Stage 3 §1.3 defines an epoch as a maximal non-decreasing counter span.
        # A delta across that boundary would join two unrelated coordinate systems.
        return

    elapsed = sample["t"] - previous["t"]
    if not finite(elapsed) or not (0 < elapsed <= MAX_SAMPLE_INTERVAL_S):
        # Wider than the poll cadence is a hole. Stage 3 §2.3 has no evidence for
        # what happened inside it, and the totals below disclose that share
        # separately; charging the whole counter jump to the bucket where the
        # record resumed would invent a placement nothing measured.
        return

    steps = sample["s"] - previous["s"]
    dist_km = sample["d"] - previous["d"]
    dur_s = sample["pe"] - previous["pe"]
    if not (finite(steps) and finite(dist_km) and finite(dur_s)):
        return
    # Inside one epoch these counters only rise. A decrease is a malformed row
    # pair, and subtracting it would silently eat real walking from the bucket.
    if steps < 0 or dist_km < 0 or dur_s < 0:
        return

    bucket["steps"] += steps
    bucket["dist_km"] += dist_km
    bucket["dur_s"] += dur_s

    if dur_s > 0 and finite(previous["v"]):
        # `pe` counts RUNNING seconds (Stage 3 §1.1), so its delta is time the
        # belt actually moved -- at the speed the EARLIER frame reported, which
        # is the speed that was in effect across the interval.
        speed = round(previous["v"], 1)
        histogram[speed] = histogram.get(speed, 0) + dur_s


def accumulate_samples(store_dir, since, until, base_bucket_s):
    buckets = {}
    histogram = {}
    first_t = None
    last_t = None
    skipped_rows = [0]
    previous = None

    for path in sample_files_in_range(store_dir, since, until):
        for sample in iter_jsonl(path, validate_sample, skipped_rows):
            timestamp = sample["t"]
            if not finite(timestamp):
                skipped_rows[0] += 1
                continue
            if since is not None and timestamp < since:
                continue
            if until is not None and timestamp > until:
                continue

            first_t = timestamp if first_t is None else min(first_t, timestamp)
            last_t = timestamp if last_t is None else max(last_t, timestamp)

            key = bucket_start(timestamp, base_bucket_s)
            bucket = buckets.get(key)
            if bucket is None:
                # A bucket exists as soon as a sample lands in it, even one that
                # carries no counter delta. Charts §4 omits buckets with NO
                # samples, so this is what keeps a measured zero -- the belt was
                # recorded here and did not advance -- distinct from no data.
                bucket = new_profile_bucket()
                buckets[key] = bucket

            if sample["b"] == "running" and finite(sample["v"]):
                # Fact 8: only "running" means the belt moved, so only those
                # frames may contribute a speed. That is the same rule store.py
                # applies to a bout's v_avg, and for the same reason -- fact 2
                # makes the near-zero speeds around a stop real but irrelevant.
                bucket["v_sum"] += sample["v"]
                bucket["v_n"] += 1

            accumulate_interval(previous, sample, bucket, histogram)
            previous = sample

    return buckets, histogram, first_t, last_t, skipped_rows[0]


def coarsen_buckets(base_buckets, base_bucket_s, bucket_s):
    if bucket_s == base_bucket_s:
        return base_buckets

    # Exact rather than approximate, because every ladder rung is a whole
    # multiple of PROFILE_BASE_BUCKET_S and of every rung below it.
    merged = {}
    for key, bucket in base_buckets.items():
        target = bucket_start(key, bucket_s)
        into = merged.get(target)
        if into is None:
            into = new_profile_bucket()
            merged[target] = into
        for field in ("steps", "dist_km", "dur_s", "v_sum", "v_n"):
            into[field] += bucket[field]
    return merged


def choose_bucket_s(start, end):
    for rung in BUCKET_LADDER_S:
        count = math.floor(end / rung) - math.floor(start / rung) + 1
        if count <= MAX_PROFILE_BUCKETS:
            return rung
    return BUCKET_LADDER_S[-1]


def profile_extent(bouts, first_sample, last_sample):
    # Charts §2.4: the axis spans the data's real extent, first activity to last,
    # not the calendar span of the period. Bouts are included alongside samples
    # because a wholly unobserved bout has exact totals and no samples at all
    # (Stage 3 §2.3); leaving it out would put a session in the rail that sits
    # outside the axis of the chart beside it.
    spans = []
    for bout in bouts:
        if finite(bout["start"]) and finite(bout["end"]):
            spans.append((bout["start"], bout["end"]))
    if first_sample is not None:
        spans.append((first_sample, last_sample))
    if not spans:
        return None, None

    start = min(span[0] for span in spans)
    end = max(max(span[1] for span in spans), start)
    return start, end


def profile_totals(bouts):
    if not bouts:
        return {
            "dur_s": 0,
            "dist_km": 0.0,
            "steps": 0,
            "v_avg": None,
            "unobserved_s": 0,
            "unobserved_dist_km": 0.0,
            "unobserved_steps": 0,
        }
    summary = summarize_bouts(bouts)
    return {
        field: summary[field]
        for field in ("dur_s", "dist_km", "steps", "v_avg",
                      "unobserved_s", "unobserved_dist_km", "unobserved_steps")
    }


def query_profile(args):
    bouts, skipped_bouts = read_bouts(args.store)
    bouts = filter_bouts(bouts, args.since, args.until)
    since = parse_iso(args.since)
    until = parse_iso(args.until)

    # An explicit bucket is accumulated directly; `auto` needs the data's extent
    # before it can pick a rung, so it accumulates at the ladder's finest rung
    # and coarsens afterwards. Either way the samples are read exactly once.
    base_bucket_s = (args.bucket if args.bucket is not None
                     else PROFILE_BASE_BUCKET_S)
    base_buckets, histogram, first_sample, last_sample, skipped_samples = (
        accumulate_samples(args.store, since, until, base_bucket_s))

    start, end = profile_extent(bouts, first_sample, last_sample)
    if args.bucket is not None:
        bucket_s = args.bucket
    elif start is None:
        bucket_s = BUCKET_LADDER_S[0]
    else:
        bucket_s = choose_bucket_s(start, end)

    buckets = coarsen_buckets(base_buckets, base_bucket_s, bucket_s)
    rows = []
    for key in sorted(buckets):
        bucket = buckets[key]
        rows.append({
            "t": key,
            "steps": bucket["steps"],
            "dist_km": round(bucket["dist_km"], 2),
            "dur_s": bucket["dur_s"],
            # Null, not zero: a bucket whose frames never reported "running" has
            # no measured speed, and drawing one at 0 km/h would assert the belt
            # was observed standing still there.
            "v_avg": (round(bucket["v_sum"] / bucket["v_n"], 1)
                      if bucket["v_n"] else None),
        })

    return {
        "bucket_s": bucket_s,
        "start": start,
        "end": end,
        "buckets": rows,
        "speed_histogram": [
            {"kmh": speed, "dur_s": dur_s}
            for speed, dur_s in sorted(histogram.items())
            if dur_s > 0
        ],
        "totals": profile_totals(bouts),
        "skipped_rows": skipped_bouts + skipped_samples,
    }


def zero_residuals(state_status):
    return {
        "state_status": state_status,
        "epoch": 0,
        "last_pad": {"elapsed_s": 0, "dist_km": 0.0, "steps": 0},
        "attributed": {"elapsed_s": 0, "dist_km": 0.0, "steps": 0},
        "residual": {"elapsed_s": 0, "dist_km": 0.0, "steps": 0},
        "last_seen_wall": None,
    }


def validate_counter(counter, field):
    if not isinstance(counter, dict):
        raise ValueError(f"{field} has the wrong type")
    require_type(counter["elapsed_s"], int, f"{field}.elapsed_s")
    require_number(counter["dist_km"], f"{field}.dist_km")
    require_type(counter["steps"], int, f"{field}.steps")


def query_residuals(args):
    path = os.path.join(args.store, "state.json")
    try:
        with open(path, "r", encoding="utf-8") as stream:
            state = json.load(stream)
    except FileNotFoundError:
        # A store with no state yet is a normal first-run result, not a failed
        # query. The explicit Stage 3 §2.4 status separates that absence from
        # both authoritative zeros and a cache that exists but cannot be trusted.
        return zero_residuals("not_found")
    except Exception:
        return zero_residuals("unreadable")

    try:
        if not isinstance(state, dict):
            raise ValueError("state.json is not an object")
        require_type(state["epoch"], int, "state.epoch")
        validate_counter(state["last_pad"], "state.last_pad")
        validate_counter(state["attributed"], "state.attributed")
        last_seen_wall = state.get("last_seen_wall")
        if last_seen_wall is not None:
            require_number(last_seen_wall, "state.last_seen_wall")
    except Exception:
        # Stage 3 §2.4 defines state.json as a reconstructable advisory cache.
        # Torn or wrong-shaped state means attribution is unknown; keep the query
        # usable while naming that uncertainty instead of reporting authoritative
        # zeros, and leave reconstruction to the raw cumulative sample evidence.
        return zero_residuals("unreadable")

    last_pad = state["last_pad"]
    attributed = state["attributed"]
    return {
        "state_status": "ok",
        "epoch": state["epoch"],
        "last_pad": last_pad,
        "attributed": attributed,
        "residual": {
            "elapsed_s": last_pad["elapsed_s"] - attributed["elapsed_s"],
            "dist_km": round(
                last_pad["dist_km"] - attributed["dist_km"], 2),
            "steps": last_pad["steps"] - attributed["steps"],
        },
        "last_seen_wall": last_seen_wall,
    }


def dispatch(args):
    if args.command == "sessions":
        return query_sessions(args)
    if args.command == "session":
        return query_session(args)
    if args.command == "totals":
        return query_totals(args)
    if args.command == "profile":
        return query_profile(args)
    return query_residuals(args)


if __name__ == "__main__":
    try:
        emit(dispatch(build_parser().parse_args()))
    except Exception as exc:
        emit({"error": str(exc)})
        sys.exit(1)
