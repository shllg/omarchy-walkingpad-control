#!/usr/bin/python3
"""Entry point for the WalkingPad bridge. See walkingpad/bridge.py."""
import argparse, os, sys

# ⚠ Load-bearing, and it must run BEFORE the first walkingpad import.
#
# This repository IS the installed plugin, so these modules are imported from
# inside the user's plugins directory. The shell watches that directory with
# `inotifywait -m -r -e close_write,create,delete,move` and no --exclude
# (omarchy/shell/services/PluginRegistry.qml), so Python writing
# walkingpad/__pycache__/*.pyc there looks exactly like the plugin changing:
# it fires a full reloadPlugins(), which bounces every other plugin's service
# and kills this bridge mid-scan -- triggered by nothing but its own first
# import. Set here rather than in the QML so it also holds when the bridge is
# run by hand.
sys.dont_write_bytecode = True

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))

from walkingpad.bridge import Bridge
from walkingpad.replay import ReplayFixtureError, ReplayTransport
from walkingpad.safety import Safety
from walkingpad import store as store_module

if __name__ == "__main__":
    ap = argparse.ArgumentParser(description="WalkingPad BLE bridge (stdio JSON)")
    ap.add_argument("--max-speed", type=float, default=6.0,
                    help="absolute ceiling in km/h (spec §7)")
    ap.add_argument("--max-step", type=float, default=0.5,
                    help="largest speed change a single command may make")
    ap.add_argument("--replay", metavar="PATH",
                    help="play captured status frames instead of using Bluetooth")
    ap.add_argument("--store", metavar="PATH", default=None,
                    help="directory for the stats store (default: %s)"
                         % store_module.DEFAULT_STORE_DIR)
    args = ap.parse_args()
    safety = Safety(max_speed=args.max_speed, max_step=args.max_step)
    transport = None
    replay_stdin_writer = None
    if args.replay is not None:
        try:
            transport = ReplayTransport(args.replay)
        except ReplayFixtureError as exc:
            ap.error(str(exc))
        # Replay is also the no-input development path. An explicit /dev/null
        # otherwise reports EOF before GLib runs the first poll, so hold only
        # that source open; real parent pipes still stop the bridge on EOF.
        if os.path.samestat(os.fstat(sys.stdin.fileno()), os.stat(os.devnull)):
            replay_stdin, replay_stdin_writer = os.pipe()
            sys.stdin = os.fdopen(replay_stdin, "r")
    bridge = Bridge(safety=safety, transport=transport)
    store_path = store_module.resolve_store_path(args.replay, args.store)
    if store_path is not None:
        # Bridge must exist first so Store can report its one failure through
        # the same stdout JSON channel without any second output owner.
        bridge.store = store_module.Store(store_path, emit=bridge.emit)
    try:
        bridge.run()
    except KeyboardInterrupt:
        pass
    finally:
        if replay_stdin_writer is not None:
            os.close(replay_stdin_writer)
