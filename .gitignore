__pycache__/
*.py[cod]
.pytest_cache/

# Local, machine-specific device addresses. Never commit.
docs/local-device.md

# Local-only agent configuration. Never commit.
AGENTS.local.md
.claude/settings.local.json

# Runtime symlink trees pointing at .agents/skills/. Never commit: a committed
